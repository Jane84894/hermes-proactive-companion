[Unit]
Description=Hermes Proactive Companion (shadow mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hermes-proactive-companion
Environment=PYTHONPATH=%h/hermes-proactive-companion/src
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.hermes/hermes-agent/.venv/bin/python -m hermes_companion.runtime --config %h/.hermes/companion/config.toml run
Restart=on-failure
RestartSec=30
TimeoutStopSec=600
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.hermes/state.db %h/.hermes/.env
ReadWritePaths=%h/.hermes/companion
PrivateTmp=true

[Install]
WantedBy=default.target
